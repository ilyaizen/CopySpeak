{
  "name": "CopySpeak",
  "version": "0.2.3",
  "description": "A simple and configurable AI-generated Text-to-Speech (TTS) orchestrator for Windows",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vp check",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:ui": "vp test --ui",
    "tauri": "tauri",
    "bump": "node ./scripts/version-bumper.mjs patch",
    "bump:minor": "node ./scripts/version-bumper.mjs minor",
    "bump:major": "node ./scripts/version-bumper.mjs major",
    "fix": "powershell -ExecutionPolicy Bypass -File ./scripts/fix-ports.ps1",
    "tree": "wsl bash -c \"tree -a -I 'node_modules|.next|src-tauri/target|.git|Handy|prompts|skills|.vercel|dist|out|gen|target|.svelte-kit|.obsidian|ui|build|icons|.agent|.agents|.claude|.tauri|.ruff_cache|__pycache__|.gemini|.opencode|.kilocode|archive|backups|bun.lock|openspec|.planning' --noreport --dirsfirst > file-structure.txt\""
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@lucide/svelte": "^1.45.0",
    "@soundtouchjs/core": "^2.1.1",
    "@tauri-apps/api": "^2.11",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "svelte-i18n": "^4.0.1",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@oxlint/plugins": "1.82.0",
    "@playwright/test": "^1.63.0",
    "@rollup/rollup-linux-x64-gnu": "^4.63.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "1.4.2",
    "@types/jsdom": "^30",
    "@types/node": "^26.1.0",
    "@vitest/ui": "5.0.0",
    "bits-ui": "^2.19.2",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1",
    "vitest": "5.0.0"
  },
  "trustedDependencies": [
    "es5-ext"
  ],
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vitest": "5.0.0"
  }
}

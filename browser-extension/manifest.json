{
  "manifest_version": 3,
  "key": "",
  "name": "CopySpeak Companion",
  "version": "0.2.4",
  "description": "Read selected page text aloud with CopySpeak and follow along with live word highlighting.",
  "minimum_chrome_version": "109",
  "permissions": ["activeTab", "contextMenus", "nativeMessaging", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "web_accessible_resources": [{ "resources": ["icons/64.png"], "matches": ["<all_urls>"] }],
  "icons": { "32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png" },
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Read selection with CopySpeak",
    "default_icon": { "32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png" }
  },
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Read the selected text with CopySpeak"
    }
  }
}
